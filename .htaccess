<IfModule LiteSpeed>
    CacheLookup Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ backend-laravel/public/ [L]
    RewriteRule (.*) backend-laravel/public/$1 [L]
</IfModule>

# Disable HTTP/3 advertisement (Alt-Svc): browsers switching to QUIC on reload can stall page assets
<IfModule mod_headers.c>
    Header always unset Alt-Svc
</IfModule>
